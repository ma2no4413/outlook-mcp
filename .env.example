# このファイルを .env にコピーして値を書き換えてください。
# 変更後は Claude Code で /mcp から再接続(または再起動)すれば反映されます。

# Azure でアプリ登録して得られる「アプリケーション (クライアント) ID」。
# 取得手順は docs/AZURE.md を参照。シークレットは不要です。
OUTLOOK_CLIENT_ID=

# common    = 個人アカウント(Hotmail/Outlook.com) + 職場/学校アカウント
# consumers = 個人アカウントのみ
OUTLOOK_TENANT=common

# true にすると、メールボックスを変更するツール(移動・既読化・ゴミ箱)が
# すべて無効になり、読み取り専用サーバとして動きます。
OUTLOOK_READONLY=false

# トークンキャッシュの置き場所。絶対パス、または このファイルからの相対パス。
# このファイルはメールボックスの鍵に相当します。共有しないでください。
OUTLOOK_TOKEN_CACHE=token_cache.json
